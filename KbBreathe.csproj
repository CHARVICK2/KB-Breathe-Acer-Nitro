<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 is built into Windows 10/11: tiny single exe, nothing to install, no extra folders -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KbBreathe</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Product>KB Breathe</Product>
    <Version>6.2</Version>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <!-- Nitrous' source is kept here as reference only; it is a separate WPF/.NET 10 app. -->
    <Compile Remove="nitrous-master\**" />
  </ItemGroup>
</Project>
